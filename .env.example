# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true only for the production domain: allows search-engine indexing
SITE_PUBLIC=false
NEXT_PUBLIC_EVENT_START=2027-02-22T00:00:00+01:00
# Dedicated conference Supabase project (public URL + publishable key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Transactional email (server-only)
RESEND_API_KEY=
CONFERENCE_FROM_EMAIL=
ORGANISER_NOTIFICATION_EMAIL=
# Registration / abstract submission are NOT controlled here. They are controlled in the
# database (public.conference_settings) from the organiser dashboard: see docs/LAUNCH_TRANSITION.md.
# No Supabase secret/service-role key is required by this application.
